--==================================================================== LOOPS
local ragThrottle = 0
local lastEsp = 0
local espInterval = IS_MOBILE and 0.028 or 0.014

RS.RenderStepped:Connect(function()
	if not gui.Parent then return end

	fovRing.Visible = S.fovOn and (S.silentAim or S.aimAssist or S.autoFire)

	if S.espLine or S.espBox or S.espHolo or S.espSkel then
		local now = os.clock()
		if now - lastEsp > espInterval then
			lastEsp = now
			updateESP()
		end
	end

	if S.aimAssist then
		local t = targetInFov(S.fov)
		if t then
			local sp = CAM:WorldToViewportPoint(t.pos)
			local c = CAM.ViewportSize / 2
			local dx, dy = (sp.X - c.X) * S.aimStrength, (sp.Y - c.Y) * S.aimStrength
			if mousemoverel then
				pcall(mousemoverel, dx, dy)
			else
				local goal = CFrame.new(CAM.CFrame.Position, t.pos)
				CAM.CFrame = CAM.CFrame:Lerp(CAM.CFrame:Lerp(goal, S.aimStrength * 0.35), 0.5)
			end
		end
	end

	if S.autoFire then
		local now = os.clock()
		local interval = math.max(0.02, 0.075 / math.max(S.fireRate, 1))
		if now - lastFire > interval and targetInFov(S.fov) then
			lastFire = now
			local tool = getTool()
			if tool then
				pcall(function() tool:Activate() end)
			elseif VirtualUser then
				pcall(function() VirtualUser:ClickButton1(CAM.ViewportSize / 2) end)
			end
		end
	end
end)

RS.Heartbeat:Connect(function()
	if not gui.Parent then return end

	if S.speed then
		local h = hum()
		if h and h.WalkSpeed ~= S.speedVal then h.WalkSpeed = S.speedVal end
	end

	if S.antiRagdoll then
		local h = hum()
		if h then
			if h.PlatformStand then h.PlatformStand = false end
			local now = os.clock()
			if now - ragThrottle > 0.2 then
				local st = h:GetState()
				if st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.FallingDown then
					ragThrottle = now
					pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end)
				end
			end
		end
	end

	if S.infStamina then
		for _, v in ipairs(stamHolders) do
			if v.Parent then
				pcall(function() v.Value = 9999 end)
			end
		end
		for _, name in ipairs(stamAttrs) do
			pcall(function() LP:SetAttribute(name, 9999) end)
		end
	end

	if invisFloor and invisProxy then
		local root = rootPart()
		if root then
			invisFloor.CFrame = CFrame.new(root.Position.X, root.Position.Y - 3, root.Position.Z)
			invisProxy.CFrame = CFrame.new(root.Position.X, invisFloor.Position.Y + 8, root.Position.Z)
		end
	end
end)

