local function sliderRow(parent, titleTxt, min, max, key, onChange, isFloat)
	local r = new("Frame", {
		Size = UDim2.new(1, -4, 0, 64),
		BackgroundColor3 = CFG.White, BackgroundTransparency = 0.2, Parent = parent,
	})
	corner(r, 15)
	stroke(r, Color3.fromRGB(228, 228, 236), 1, 0.3)

	local function fmt(v)
		if isFloat then return string.format("%.1fx", v) end
		return tostring(v)
	end

	local lbl = new("TextLabel", {
		Size = UDim2.new(1, -26, 0, 15), Position = UDim2.fromOffset(13, 10),
		BackgroundTransparency = 1, Text = titleTxt .. "  ·  " .. fmt(S[key]),
		TextSize = 11, TextColor3 = CFG.Ink, Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left, Active = false, Parent = r,
	})
	local bar = new("Frame", {
		Size = UDim2.new(1, -26, 0, 6), Position = UDim2.fromOffset(13, 42),
		BackgroundColor3 = Color3.fromRGB(226, 226, 234), Active = false, Parent = r,
	})
	corner(bar, 3)
	local fill = new("Frame", {
		Size = UDim2.fromScale((S[key] - min) / (max - min), 1),
		BackgroundColor3 = CFG.Ink, Active = false, Parent = bar,
	})
	corner(fill, 3)
	local hit = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 32),
		BackgroundTransparency = 1, Text = "", Parent = r,
	})

	local function apply(px)
		local a = bar.AbsoluteSize.X
		if a <= 0 then return end
		local alpha = math.clamp(px / a, 0, 1)
		local v
		if isFloat then
			v = math.floor((min + (max - min) * alpha) * 10 + 0.5) / 10
		else
			v = math.floor(min + (max - min) * alpha + 0.5)
		end
		S[key] = v
		fill.Size = UDim2.fromScale(alpha, 1)
		lbl.Text = titleTxt .. "  ·  " .. fmt(v)
		if onChange then onChange(v) end
	end

	local dragging = false
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			apply(i.Position.X - bar.AbsolutePosition.X)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
			apply(i.Position.X - bar.AbsolutePosition.X)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	return r
end

