local function getWeapon()
	local char = LP.Character
	if not char then return nil end
	local eq = char:FindFirstChildOfClass("Tool")
	if eq then return eq end
	local bp = LP:FindFirstChildOfClass("Backpack")
	if not bp then return nil end
	local list = {}
	for _, t in ipairs(bp:GetChildren()) do
		if t:IsA("Tool") then table.insert(list, t) end
	end
	if #list == 0 then return nil end
	local pick = list[math.random(1, #list)]
	pick.Parent = char
	local h = hum()
	if h then pcall(function() h:EquipTool(pick) end) end
	return pick
end

local tpBusy = false
local function teleportKill()
	if tpBusy then return end
	tpBusy = true
	inject("Teleport Kill", 0.9, function()
		local root = rootPart()
		if not root then tpBusy = false return end
		local weapon = getWeapon()
		if not weapon then
			notify("SIN ARMAS · compra un arma primero")
			tpBusy = false
			return
		end
		task.wait(0.35)
		local origin = root.CFrame
		local list = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LP then
				local r = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				local hp = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
				if r and hp and hp.Health > 0 then
					table.insert(list, { r = r, d = (r.Position - root.Position).Magnitude })
				end
			end
		end
		table.sort(list, function(a, b) return a.d < b.d end)
		if #list == 0 then
			notify("Sin enemigos cerca")
			tpBusy = false
			return
		end
		for _, e in ipairs(list) do
			local r = rootPart()
			if not r then break end
			pcall(function() r.CFrame = e.r.CFrame end)
			task.wait(0.1)
			pcall(function() weapon:Activate() end)
			task.wait(0.14)
		end
		task.wait(0.2)
		local back = rootPart()
		if back then back.CFrame = origin end
		notify("Teleport Kill · " .. tostring(#list) .. " objetivos")
		tpBusy = false
	end)
end

