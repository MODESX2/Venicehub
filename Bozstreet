local stamHolders, stamAttrs = {}, {}

local function findStamina()
	stamHolders, stamAttrs = {}, {}
	local roots = { LP.Character, LP }
	for _, root in ipairs(roots) do
		if root then
			for _, d in ipairs(root:GetDescendants()) do
				if (d:IsA("NumberValue") or d:IsA("IntValue")) and string.find(string.lower(d.Name), "stam", 1, true) then
					table.insert(stamHolders, d)
				end
			end
		end
	end
	for name in pairs(LP:GetAttributes()) do
		if string.find(string.lower(name), "stam", 1, true) then
			table.insert(stamAttrs, name)
		end
	end
	return #stamHolders + #stamAttrs
end

