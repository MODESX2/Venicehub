--==================================================================== HELPERS
local function new(cls, props)
	local o = Instance.new(cls)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then o[k] = v end
	end
	if props and props.Parent then o.Parent = props.Parent end
	return o
end
local function corner(o, r)
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = o; return c
end
local function stroke(o, col, th, tr)
	local s = Instance.new("UIStroke")
	s.Color = col; s.Thickness = th or 1; s.Transparency = tr or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = o; return s
end
local function tw(o, ti, goal) local t = TS:Create(o, ti, goal); t:Play(); return t end
local EASE = TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local TAP  = TweenInfo.new(0.09, Enum.EasingStyle.Quad)

local function parentGui(g)
	local ok = pcall(function() g.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
	if not ok then g.Parent = LP:WaitForChild("PlayerGui") end
end

local function hum() local c = LP.Character; return c and c:FindFirstChildOfClass("Humanoid") end
local function rootPart() local c = LP.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local function getTool() local c = LP.Character; return c and c:FindFirstChildOfClass("Tool") end

local function pressFx(b)
	b.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
			tw(b, TAP, { Size = UDim2.new(b.Size.X.Scale, b.Size.X.Offset - 2, b.Size.Y.Scale, b.Size.Y.Offset - 2) })
		end
	end)
	b.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
			tw(b, EASE, { Size = b.Size })
		end
	end)
end

