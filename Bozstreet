--==================================================================== WEAPON MODS
local patched = {}

local PAT = {
	rate   = { "cooldown", "firerate", "fire_rate", "fire rate", "delay", "interval", "ratetime" },
	recoil = { "recoil", "kick", "shake" },
	spread = { "spread", "bloom", "inaccuracy" },
}

local function scanValues(root, patterns)
	local hits = {}
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("NumberValue") or d:IsA("IntValue") then
			local n = string.lower(d.Name)
			for _, p in ipairs(patterns) do
				if string.find(n, p, 1, true) then
					table.insert(hits, d)
					break
				end
			end
		end
	end
	return hits
end

local function patchTo(v, target)
	if patched[v] == nil then patched[v] = v.Value end
	v.Value = target
end

local function applyWeaponMods()
	local tool = getTool()
	if not tool then return end
	if S.fireRate > 1 then
		for _, v in ipairs(scanValues(tool, PAT.rate)) do
			if patched[v] == nil then patched[v] = v.Value end
			v.Value = patched[v] / S.fireRate
		end
	end
	if S.noRecoil then
		for _, v in ipairs(scanValues(tool, PAT.recoil)) do patchTo(v, 0) end
	end
	if S.noSpread then
		for _, v in ipairs(scanValues(tool, PAT.spread)) do patchTo(v, 0) end
	end
end

local function restoreWeaponMods()
	for inst, orig in pairs(patched) do
		if inst and inst.Parent then
			pcall(function() inst.Value = orig end)
		end
	end
	patched = {}
end

local function modsActive()
	return S.fireRate > 1 or S.noRecoil or S.noSpread
end

