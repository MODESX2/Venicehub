local mouse = LP:GetMouse()
local lastFire = 0

local function targetInFov(fov)
	local center = CAM.ViewportSize / 2
	local best, bestD = nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP then
			local char = plr.Character
			local hp = char and char:FindFirstChildOfClass("Humanoid")
			if hp and hp.Health > 0 then
				local t = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
				if t then
					local sp, on = CAM:WorldToViewportPoint(t.Position)
					if on then
						local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
						if d <= fov and d < bestD then
							bestD = d
							best = { plr = plr, pos = t.Position, part = t }
						end
					end
				end
			end
		end
	end
	return best
end

pcall(function()
	local oldIndex = hookmetamethod(game, "__index", function(self, key)
		if S.silentAim and self == mouse then
			local t = targetInFov(S.fov)
			if t then
				if key == "Hit" then return CFrame.new(t.pos) end
				if key == "Target" then return t.part end
				if key == "UnitRay" then
					local o = CAM.CFrame.Position
					return Ray.new(o, (t.pos - o).Unit)
				end
			end
		end
		return oldIndex(self, key)
	end)

	local oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
		local m = getnamecallmethod()
		if S.silentAim and self == CAM and (m == "ViewportPointToRay" or m == "ScreenPointToRay") then
			local t = targetInFov(S.fov)
			if t then
				local ray = oldNamecall(self, ...)
				return Ray.new(ray.Origin, (t.pos - ray.Origin).Unit)
			end
		end
		return oldNamecall(self, ...)
	end)
end)

