local function onChar(char)
	task.wait(1.2)
	if S.hitbox then applyHitbox(char, true) end
	if char == LP.Character then
		local h = char:FindFirstChildOfClass("Humanoid")
		if h and S.speed then h.WalkSpeed = S.speedVal end
		if S.infStamina then findStamina() end
		patched = {}
		if invisProxy then
			invisProxy:Destroy(); invisProxy = nil
			if invisFloor then invisFloor:Destroy(); invisFloor = nil end
			savedParts = nil
		end
	end
end

