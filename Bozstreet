local function centerWin()
	local vp = CAM.ViewportSize
	local sc = winScale.Scale
	local w = winW * sc
	local h = winH * sc
	win.Position = UDim2.fromOffset(
		math.max(4, (vp.X - w) / 2),
		math.max(4, (vp.Y - h) / 2)
	)
end

local function relayout()
	local vp = CAM.ViewportSize
	local stacked = IS_MOBILE and (vp.Y > vp.X)

	if IS_MOBILE then
		local sc = math.clamp(vp.X / 400, 0.9, 1.55)
		winScale.Scale = sc
		orbScale.Scale = sc
		local targetW = stacked and (vp.X * 0.96) or math.min(vp.X * 0.62, 620)
		targetW = math.clamp(targetW, 292, vp.X - 16)
		local targetH = math.clamp(vp.Y * (stacked and 0.84 or 0.78), 360, 640)
		winW = math.floor(targetW / sc)
		winH = math.floor(targetH / sc)
	else
		winScale.Scale = 1
		orbScale.Scale = 1
		winW = math.clamp(vp.X - 160, 480, 660)
		winH = math.clamp(vp.Y - 160, 430, 620)
	end

	win.Size = UDim2.fromOffset(winW, winH)
	centerWin()

	if stacked then
		previewWrap.Size = UDim2.new(1, 0, 0.34, -4)
		previewWrap.Position = UDim2.fromOffset(0, 0)
		espScroll.Size = UDim2.new(1, 0, 0.66, -4)
		espScroll.Position = UDim2.new(0, 0, 0.66, 4)
	else
		previewWrap.Size = UDim2.new(0.42, -4, 1, 0)
		previewWrap.Position = UDim2.fromOffset(0, 0)
		espScroll.Size = UDim2.new(0.58, 0, 1, 0)
		espScroll.Position = UDim2.new(0.42, 4, 0, 0)
	end

	fovRing.Size = UDim2.fromOffset(S.fov * 2, S.fov * 2)
	loadW = math.clamp(winW - 44, 240, 340)
	loader.Size = UDim2.fromOffset(loadW, 78)
	loader.Position = UDim2.new(0.5, -loadW / 2, 0.5, -39)
end

local okLayout, errLayout = pcall(relayout)
if not okLayout then print("VENICE · error en layout:", errLayout) end

