local pool = {}

local function getPool(plr)
	if pool[plr] then return pool[plr] end
	local p = {
		line = new("Frame", {
			BackgroundColor3 = CFG.White, Size = UDim2.fromOffset(1, 0),
			Visible = false, Active = false, Parent = espGui,
		}),
		box = new("Frame", {
			BackgroundColor3 = CFG.White, BackgroundTransparency = 1,
			Visible = false, Active = false, Parent = espGui,
		}),
		segments = {},
	}
	stroke(p.box, CFG.White, 1, 0.05)
	pool[plr] = p
	return p
end

local function killPool(plr)
	local p = pool[plr]
	if not p then return end
	p.line:Destroy()
	p.box:Destroy()
	for _, s in pairs(p.segments) do s:Destroy() end
	pool[plr] = nil
end

local function project(v3)
	local sp, on = CAM:WorldToViewportPoint(v3)
	if not on then return nil end
	return Vector2.new(sp.X, sp.Y)
end

local function setSeg(p, i)
	if not p.segments[i] then
		p.segments[i] = new("Frame", {
			BackgroundColor3 = CFG.White, Size = UDim2.fromOffset(0, 1),
			Visible = false, Active = false, Parent = espGui,
		})
	end
	return p.segments[i]
end

local function drawSeg(seg, a, b)
	local d = b - a
	seg.Position = UDim2.fromOffset(a.X, a.Y - 0.5)
	seg.Size = UDim2.fromOffset(d.Magnitude, 1)
	seg.Rotation = math.deg(math.atan2(d.Y, d.X))
	seg.Visible = true
end

local function ensureHolo(char)
	local h = char:FindFirstChild("VeniceHolo")
	if not h then
		h = new("Highlight", {
			Name = "VeniceHolo", Adornee = char, FillColor = S.holoColor,
			FillTransparency = 0.45, OutlineColor = CFG.White,
			OutlineTransparency = 0.15,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Parent = char,
		})
	end
	h.FillColor = S.holoColor
	return h
end

local function updateESP()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP then
			local char = plr.Character
			local hp = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local head = char and char:FindFirstChild("Head")
			local p = pool[plr]

			if not (char and hp and root and hp.Health > 0) then
				if p then
					p.line.Visible = false
					p.box.Visible = false
					for _, s in pairs(p.segments) do s.Visible = false end
				end
				local h = char and char:FindFirstChild("VeniceHolo")
				if h then h.Enabled = false end
			elseif (CAM.CFrame.Position - root.Position).Magnitude < 700 then
				p = p or getPool(plr)
				local top = project(root.Position + Vector3.new(0, root.Size.Y / 2 + 1.1, 0))
				local bottom = project(root.Position - Vector3.new(0, root.Size.Y / 2 + 2.4, 0))

				if top and bottom then
					local hgt = math.abs(bottom.Y - top.Y)
					if hgt > 5 then
						local w = hgt * 0.52
						if S.espBox then
							p.box.Visible = true
							p.box.Position = UDim2.fromOffset(top.X - w / 2, top.Y)
							p.box.Size = UDim2.fromOffset(w, hgt)
						else
							p.box.Visible = false
						end
						if S.espLine then
							p.line.Visible = true
							p.line.Position = UDim2.fromOffset(top.X, top.Y - 26)
							p.line.Size = UDim2.fromOffset(1, hgt + 26)
						else
							p.line.Visible = false
						end
					end
				else
					p.box.Visible = false
					p.line.Visible = false
				end

				local idx = 0
				if S.espSkel then
					for _, m in ipairs(char:GetDescendants()) do
						if m:IsA("Motor6D") and m.Part0 and m.Part1 then
							local a = project(m.Part0.Position)
							local b = project(m.Part1.Position)
							if a and b then
								idx = idx + 1
								drawSeg(setSeg(p, idx), a, b)
							end
						end
					end
					if head then
						local c = project(head.Position)
						local r = project(head.Position + Vector3.new(0, 0.9, 0))
						if c and r then
							local rad = math.abs(r.Y - c.Y) * 0.5
							idx = idx + 1
							drawSeg(setSeg(p, idx), Vector2.new(c.X - rad, c.Y), Vector2.new(c.X + rad, c.Y))
						end
					end
				end
				for i = idx + 1, #p.segments do p.segments[i].Visible = false end

				local holo = char:FindFirstChild("VeniceHolo")
				if S.espHolo then
					holo = ensureHolo(char)
					holo.Enabled = true
					holo.FillColor = S.holoColor
					if S.espSkel then
						for _, s in pairs(p.segments) do s.Visible = false end
					end
				elseif holo then
					holo.Enabled = false
				end
			elseif p then
				p.line.Visible = false
				p.box.Visible = false
			end
		end
	end
end

