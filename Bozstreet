local invisFloor, invisProxy, savedParts, savedCF

local function setInvisible(on)
	local char = LP.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local h = hum()
	if not (char and root and h) then return end

	if on then
		if invisProxy then return end
		savedCF = root.CFrame
		savedParts = {}
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(savedParts, { p = d, t = d.Transparency, c = d.CanCollide })
				d.Transparency = 1
				d.CanCollide = false
			end
		end
		invisFloor = new("Part", {
			Name = "VeniceFloor", Size = Vector3.new(26, 1, 26), Anchored = true,
			CanCollide = true, Transparency = 1,
			CFrame = savedCF * CFrame.new(0, -6, 0), Parent = WS,
		})
		invisProxy = new("Part", {
			Name = "VeniceProxy", Size = Vector3.new(1, 1, 1), Anchored = true,
			CanCollide = false, Transparency = 1, CFrame = savedCF, Parent = WS,
		})
		h.CameraSubject = invisProxy
		root.CFrame = savedCF * CFrame.new(0, -6, 0)
		notify("Invisible ACTIVO · cuerpo bajo el mapa")
	else
		if savedParts then
			for _, d in ipairs(savedParts) do
				if d.p and d.p.Parent then
					d.p.Transparency = d.t
					d.p.CanCollide = d.c
				end
			end
		end
		savedParts = nil
		if invisProxy then
			if root then root.CFrame = invisProxy.CFrame end
			invisProxy:Destroy()
			invisProxy = nil
		end
		if invisFloor then invisFloor:Destroy(); invisFloor = nil end
		if h then h.CameraSubject = h end
		notify("Invisible DESACTIVADO")
	end
end

