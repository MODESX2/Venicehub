local function draggable(target, handleObj, onTap)
	local dragging, startPos, startOff, moved = false, nil, nil, 0
	local moveConn

	handleObj.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			moved = 0
			startPos = Vector2.new(i.Position.X, i.Position.Y)
			startOff = Vector2.new(target.AbsolutePosition.X, target.AbsolutePosition.Y)
			if moveConn then moveConn:Disconnect() end
			moveConn = UIS.InputChanged:Connect(function(m)
				if not dragging then return end
				if m.UserInputType == Enum.UserInputType.Touch or m.UserInputType == Enum.UserInputType.MouseMovement then
					local d = Vector2.new(m.Position.X, m.Position.Y) - startPos
					moved = math.max(moved, d.Magnitude)
					local vp = CAM.ViewportSize
					local sz = target.AbsoluteSize
					local nx = math.clamp(startOff.X + d.X, 0, math.max(0, vp.X - sz.X))
					local ny = math.clamp(startOff.Y + d.Y, 0, math.max(0, vp.Y - sz.Y))
					target.Position = UDim2.fromOffset(nx, ny)
				end
			end)
		end
	end)

	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
			if dragging and moved < 22 and onTap then onTap() end
			dragging = false
			if moveConn then moveConn:Disconnect(); moveConn = nil end
		end
	end)
end

local opened = false

local function openMenu()
	if opened then return end
	opened = true
	pcall(relayout)
	win.Visible = true
	win.BackgroundTransparency = 1
	tw(win, TweenInfo.new(0.28, Enum.EasingStyle.Quint), { BackgroundTransparency = 0.05 })
	tw(blur, TweenInfo.new(0.3), { Size = 14 })
	pcall(buildPreview)
	pcall(refreshPreview)
end

local function closeMenu()
	if not opened then return end
	opened = false
	tw(win, TweenInfo.new(0.22, Enum.EasingStyle.Quint), { BackgroundTransparency = 1 })
	tw(blur, TweenInfo.new(0.25), { Size = 0 })
	task.delay(0.22, function() win.Visible = false end)
end

local function toggleMenu()
	print("VENICE: entrada tocada, opened =", opened)
	pcall(function()
		if opened then closeMenu() else openMenu() end
	end)
end

